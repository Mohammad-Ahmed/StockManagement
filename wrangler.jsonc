{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "solestock-cloudflare",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-15",
  "compatibility_flags": ["python_workers"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "solestock-db",
      "database_id": "61517f77-cc59-48ce-a032-2faa83bc6801"
    }
  ],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false
  },
  "observability": {
    "enabled": true
  }
}
